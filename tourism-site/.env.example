# Секрет для подписи JWT-токенов туристов (личный кабинет)
JWT_SECRET=change-me-to-a-long-random-string

# Токен доступа к админ-панели /admin.html
ADMIN_TOKEN=change-me-to-a-long-random-string

# Порт сервера (необязательно, по умолчанию 3000)
PORT=3000

# Необязательно: уведомления о новых заявках в Telegram.
# Создайте бота через @BotFather (получите токен) и узнайте chat_id
# (например, напишите боту и откройте https://api.telegram.org/bot<TOKEN>/getUpdates).
# Если не заданы — уведомления просто не отправляются, ошибок не будет.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
