# Higgsfield API credentials (from https://cloud.higgsfield.ai -> API Keys)
HF_API_KEY_ID=your-key-id-here
HF_API_KEY_SECRET=your-key-secret-here

# Any long random string YOU choose - this protects your server so only you
# (with this token) can call it. Generate one with:
#   openssl rand -hex 32
MCP_ACCESS_TOKEN=choose-a-long-random-string-here

# Optional, most hosts (Render/Railway) set this automatically
PORT=3000
